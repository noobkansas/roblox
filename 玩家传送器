-- v15: 数字解析（支持中英文逗号 / 空格 / 全角）
local function toNumber(v)
    if type(v) == "number" then return v end
    if type(v) ~= "string" then return nil end
    local s = v
    s = s:gsub("，", "."):gsub(",", "."):gsub("。", ".")
    s = s:gsub("％", ""):gsub("%%", "")
    s = s:gsub("^%s+", ""):gsub("%s+$", "")
    s = s:gsub("　", "")
    return tonumber(s)
end

local function saveCfg()
    if not hasFile then return end
    local dump = {}
    for k, v in pairs(St) do dump[k] = v end
    dump._cfgVersion = CFG_VERSION
    local ok, en = pcall(function() return Http:JSONEncode(dump) end)
    if ok and en then pcall(writefile, SAVE_FILE, en) end
end

local function loadCfg()
    if not hasFile then return end
    local ok, ex = pcall(isfile, SAVE_FILE)
    if not ok or not ex then return end
    local ok2, c = pcall(readfile, SAVE_FILE)
    if not ok2 or type(c) ~= "string" then return end
    local ok3, d = pcall(function() return Http:JSONDecode(c) end)
    if not ok3 or type(d) ~= "table" then return end
    if tonumber(d._cfgVersion or 0) > CFG_VERSION then return end
    for k, v in pairs(d) do
        if k:sub(1,1) ~= "_" then
            if k == "offset" and type(v) == "table" then
                St.offset.x = tostring(v.x or "0")
                St.offset.y = tostring(v.y or "5")
                St.offset.z = tostring(v.z or "0")
            elseif (k == "tpTargets" or k == "camList") and type(v) == "table" then
                local arr = {}
                for _, uid in ipairs(v) do local n = tonumber(uid); if n then table.insert(arr, n) end end
                St[k] = arr
            elseif k == "blocks" and type(v) == "table" then
                St.blocks = v
            elseif k == "selected" or k == "selAll" or k == "selTp" or k == "selCam" then
            else
                St[k] = v
            end
        end
    end
end
