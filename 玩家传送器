createBlock({
    id = "cam_ctrl", title = "摄像机控制（作用于摄像机列表）", order = 3,
    build = function(bd, self)
        local status = mk("Frame", { Size=UDim2.new(1,0,0,30), BackgroundColor3=Th.Bg, BorderSizePixel=0, LayoutOrder=1, Parent=bd })
        mk("UICorner", { CornerRadius=UDim.new(0,6), Parent=status })
        mk("UIStroke", { Color=Th.Str, Thickness=1, Parent=status })
        local lbl = mk("TextLabel", { Size=UDim2.new(1,-16,1,0), Position=UDim2.fromOffset(10,0), BackgroundTransparency=1, Font=Enum.Font.Gotham, TextSize=11, TextColor3=Th.Sub, TextXAlignment=Enum.TextXAlignment.Left, Text="未锁定", Parent=status })
        local function upd()
            if St.camCurrent then
                local plr = Players:GetPlayerByUserId(St.camCurrent)
                if plr then lbl.Text = "锁定 → "..plr.Name; lbl.TextColor3 = Th.Ok; return end
            end
            if St.tempFollow then
                local plr = Players:GetPlayerByUserId(St.tempFollow)
                if plr then lbl.Text = "临时跟随 → "..plr.Name; lbl.TextColor3 = Th.Warn; return end
            end
            lbl.Text = "未锁定"; lbl.TextColor3 = Th.Sub
        end
        self._updCamStatus = upd; upd()
        local lockSelB = mk("TextButton", { Size=UDim2.new(1,0,0,28), BackgroundColor3=Th.Acc, BorderSizePixel=0, AutoButtonColor=true, Font=Enum.Font.GothamBold, TextSize=12, TextColor3=Color3.fromRGB(255,255,255), Text="锁定选中（取第一个）", LayoutOrder=2, Parent=bd })
        mk("UICorner", { CornerRadius=UDim.new(0,6), Parent=lockSelB })
        trk(lockSelB.MouseButton1Click:Connect(function()
            local uids = collectSelUids(St.camList, St.selCam)
            if #uids == 0 then notify("摄像机", "未在摄像机列表选中目标", 1.5, Th.Warn); return end
            local uid = uids[1]
            local plr = Players:GetPlayerByUserId(uid)
            if not plr or not isPlayerAlive(plr) then notify("摄像机", "第一个选中无效", 1.5, Th.Warn); return end
            setCamTarget(uid)
            if renderCamListFn then renderCamListFn() end
            for _, r in pairs(allRows) do if r._upd then r._upd() end end
        end))
        local unB = mk("TextButton", { Size=UDim2.new(1,0,0,28), BackgroundColor3=Th.Sur, BorderSizePixel=0, AutoButtonColor=true, Font=Enum.Font.GothamBold, TextSize=12, TextColor3=Th.Txt, Text="解除锁定", LayoutOrder=3, Parent=bd })
        mk("UICorner", { CornerRadius=UDim.new(0,6), Parent=unB })
        mk("UIStroke", { Color=Th.Str, Thickness=1, Parent=unB })
        trk(unB.MouseButton1Click:Connect(function()
            setCamTarget(nil)
            if renderCamListFn then renderCamListFn() end
            for _, r in pairs(allRows) do if r._upd then r._upd() end end
        end))
        local addB = mk("TextButton", { Size=UDim2.new(1,0,0,28), BackgroundColor3=Th.Sur, BorderSizePixel=0, AutoButtonColor=true, Font=Enum.Font.GothamBold, TextSize=12, TextColor3=Th.Txt, Text="将当前锁定加入传送列表", LayoutOrder=4, Parent=bd })
        mk("UICorner", { CornerRadius=UDim.new(0,6), Parent=addB })
        mk("UIStroke", { Color=Th.Str, Thickness=1, Parent=addB })
        trk(addB.MouseButton1Click:Connect(function()
            local target = St.camCurrent or St.tempFollow
            if not target then notify("摄像机","未锁定目标",1.5,Th.Warn); return end
            addToList(St.tpTargets, target); saveCfg()
            if renderTpListFn then renderTpListFn() end
            for _, r in pairs(allRows) do if r._upd then r._upd() end end
            local plr = Players:GetPlayerByUserId(target)
            notify("摄像机", "已加入传送列表："..(plr and plr.Name or "?"), 2, Th.Ok)
        end))
    end,
})

