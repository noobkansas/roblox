local allBlocks = {}
local function getBlockState(id)
    if not St.blocks[id] then St.blocks[id] = {} end
    local b = St.blocks[id]
    b.detached = b.detached or false
    b.minimized = b.minimized or false
    b.detX = b.detX or 140
    b.detY = b.detY or 120
    b.detW = b.detW or 380
    b.detH = b.detH or 320
    return b
end

local function applyGlobalVisibility()
    main.Visible = not St.hidden
    for _, bl in pairs(allBlocks) do
        if bl.host == "detached" then bl.frame.Visible = not St.hidden end
    end
end

local function createBlock(cfg)
    local id = cfg.id
    local bst = getBlockState(id)
    local frm = mk("Frame", {
        Name="Blk_"..id, Size=UDim2.new(1,0,0,HDR_H),
        BackgroundColor3=Th.Sec, BorderSizePixel=0, Active=true,
        ClipsDescendants=true, LayoutOrder=cfg.order or 100,
        ZIndex=110, Parent=cInner,
    })
    mk("UICorner", { CornerRadius=UDim.new(0,8), Parent=frm })
    mk("UIStroke", { Color=Th.Str, Thickness=1, Parent=frm })

    local hdr = mk("Frame", {
        Name="H", Size=UDim2.new(1,0,0,HDR_H), BackgroundColor3=Th.Sur,
        BorderSizePixel=0, Active=true, ZIndex=1, Parent=frm,
    })
    mk("UICorner", { CornerRadius=UDim.new(0,8), Parent=hdr })
    mk("TextLabel", {
        Size=UDim2.new(1,-100,1,0), Position=UDim2.fromOffset(12,0),
        BackgroundTransparency=1, Font=Enum.Font.GothamBold, TextSize=12,
        TextColor3=Th.Txt, TextXAlignment=Enum.TextXAlignment.Left,
        Text=cfg.title, ZIndex=2, Parent=hdr, Active=false,
    })
    local detBtn = mk("TextButton", {
        Size=UDim2.fromOffset(26,26), Position=UDim2.new(1,-64,0.5,-13),
        BackgroundColor3=Th.BluBtn, BorderSizePixel=0, AutoButtonColor=true,
        Font=Enum.Font.GothamBold, TextSize=14, TextColor3=Color3.fromRGB(255,255,255), Text="⇱",
        ZIndex=2, Parent=hdr,
    })
    mk("UICorner", { CornerRadius=UDim.new(0,6), Parent=detBtn })
    local minBtn = mk("TextButton", {
        Size=UDim2.fromOffset(26,26), Position=UDim2.new(1,-34,0.5,-13),
        BackgroundColor3=Th.Bg, BorderSizePixel=0, AutoButtonColor=true,
        Font=Enum.Font.GothamBold, TextSize=16, TextColor3=Th.Txt, Text="—",
        ZIndex=2, Parent=hdr,
    })
    mk("UICorner", { CornerRadius=UDim.new(0,6), Parent=minBtn })
    mk("UIStroke", { Color=Th.Str, Thickness=1, Parent=minBtn })

    local body = mk("Frame", {
        Name="B", Size=UDim2.new(1,0,0,0), Position=UDim2.fromOffset(0,HDR_H),
        AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1,
        ZIndex=1, Parent=frm,
    })
    mk("UIListLayout", {
        Name="IL", FillDirection=Enum.FillDirection.Vertical,
        SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,6), Parent=body,
    })
    mk("UIPadding", {
        PaddingTop=UDim.new(0,8), PaddingBottom=UDim.new(0,8),
        PaddingLeft=UDim.new(0,10), PaddingRight=UDim.new(0,10), Parent=body,
    })
    local rh = mk("Frame", {
        Name="RH", AnchorPoint=Vector2.new(1,1), Position=UDim2.new(1,-4,1,-4),
        Size=UDim2.fromOffset(HDL,HDL), BackgroundColor3=Th.Hdl,
        BackgroundTransparency=0.15, BorderSizePixel=0, Active=true,
        Visible=false, ZIndex=60, Parent=frm,
    })
    mk("UICorner", { CornerRadius=UDim.new(0,3), Parent=rh })

    local self = {
        id=id, frame=frm, header=hdr, body=body, toggle=minBtn, rh=rh,
        detBtn=detBtn, host="main", scrollFrame=nil, layoutOrder=cfg.order or 100,
    }

    local function updateHandle()
        rh.Visible = (self.host == "detached" and not bst.minimized)
        if self.host == "detached" then
            detBtn.Text = "⇲"; detBtn.BackgroundColor3 = Th.Grn
        else
            detBtn.Text = "⇱"; detBtn.BackgroundColor3 = Th.BluBtn
        end
    end
    local function refreshHeight()
        if self.host ~= "main" then return end
        if bst.minimized then frm.Size = UDim2.new(1,0,0,HDR_H)
        else
            local bh = body.AbsoluteSize.Y
            if bh and bh > 0 then frm.Size = UDim2.new(1,0,0,HDR_H + bh) end
        end
    end
    trk(body:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if self.host == "main" then refreshHeight() end
    end))

    local function applyMinimized()
        body.Visible = not bst.minimized
        minBtn.Text = bst.minimized and "+" or "—"
        if self.host == "main" then refreshHeight()
        else
            if bst.minimized then frm.Size = UDim2.fromOffset(frm.AbsoluteSize.X, HDR_H)
            else frm.Size = UDim2.fromOffset(bst.detW, bst.detH) end
        end
        updateHandle()
    end
    self.applyMinimized = applyMinimized

    trk(minBtn.MouseButton1Click:Connect(function()
        bst.minimized = not bst.minimized; applyMinimized(); saveCfg()
    end))

    if cfg.build then cfg.build(body, self) end

    trk(rh.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if self.host ~= "detached" then return end
        startResize(frm, input.Position, {
            minW=220, minH=HDR_H+20, maxW=900, maxH=1400,
            onEnd=function()
                bst.detW = frm.AbsoluteSize.X; bst.detH = frm.AbsoluteSize.Y; saveCfg()
            end,
        })
    end))

    function self:detach()
        if self.host == "detached" then return end
        local finalW = bst.detW or 380
        local finalH = bst.detH or math.max(200, HDR_H + body.AbsoluteSize.Y + 20)
        bst.detW, bst.detH = finalW, finalH
        frm.Size = UDim2.fromOffset(finalW, finalH)
        frm.Parent = sg
        frm.Position = UDim2.fromOffset(bst.detX, bst.detY)
        frm.ZIndex = nextZ()
        local sf = mk("ScrollingFrame", {
            Name="SF", Size=UDim2.new(1,0,1,-HDR_H), Position=UDim2.fromOffset(0,HDR_H),
            BackgroundTransparency=1, BorderSizePixel=0,
            CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
            ScrollBarThickness=4, ScrollBarImageColor3=Th.Str, ZIndex=1, Parent=frm,
        })
        body.Parent = sf; body.Position = UDim2.fromOffset(0,0); body.Size = UDim2.new(1,0,0,0)
        self.scrollFrame = sf
        self.host = "detached"; bst.detached = true
        applyMinimized(); applyGlobalVisibility()
    end

    function self:attach()
        if self.host ~= "detached" then return end
        if self.scrollFrame then
            body.Parent = frm; self.scrollFrame:Destroy(); self.scrollFrame = nil
        end
        frm.Parent = cInner; frm.Position = UDim2.fromOffset(0,0); frm.ZIndex = 110
        frm.LayoutOrder = self.layoutOrder
        body.Position = UDim2.fromOffset(0,HDR_H); body.Size = UDim2.new(1,0,0,0)
        self.host = "main"; bst.detached = false
        applyMinimized(); applyGlobalVisibility()
    end

    trk(hdr.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if dragState then return end
        local ix, iy = input.Position.X, input.Position.Y
        if inRect(ix, iy, minBtn) then return end
        if inRect(ix, iy, detBtn) then return end
        local now = tick()
        local isDbl = (now - (self._lastClick or 0)) < (DBL_MS / 1000)
        self._lastClick = now
        if isDbl then
            if self.host == "main" then self:detach() else self:attach() end
            return
        end
        if self.host == "detached" then
            frm.ZIndex = nextZ()
            startDrag(frm, input.Position, function()
                bst.detX = frm.Position.X.Offset; bst.detY = frm.Position.Y.Offset; saveCfg()
            end)
        end
    end))
    trk(detBtn.MouseButton1Click:Connect(function()
        if self.host == "main" then self:detach() else self:attach() end
        saveCfg()
    end))

    allBlocks[id] = self
    if bst.detached then task.defer(function() if not dead then self:detach() end end)
    else applyMinimized() end
    return self
end

-- ==================== 工具 ====================
local function getMyRoot()
    local ch = LP.Character
    return ch and ch:FindFirstChild("HumanoidRootPart") or nil
end
local function getPlayerRoot(plr)
    if not plr then return nil end
    local ch = plr.Character
    return ch and ch:FindFirstChild("HumanoidRootPart") or nil
end
local function isPlayerAlive(plr)
    if not plr or not plr.Parent then return false end
    local ch = plr.Character
    if not ch then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return ch:FindFirstChild("HumanoidRootPart") ~= nil
end
local function inList(list, uid)
    for _, v in ipairs(list) do if v == uid then return true end end
    return false
end
local function addToList(list, uid)
    if not inList(list, uid) then table.insert(list, uid) end
end
local function removeFromList(list, uid)
    for i = #list, 1, -1 do if list[i] == uid then table.remove(list, i) end end
end

local function computeDestAndFace(targetRoot)
    local offsetVec, anyLocal = parseOffset()
    local useLocal = anyLocal or St.localOffset
    if not useLocal or not targetRoot or not targetRoot.Parent then
        return targetRoot.Position + offsetVec, nil
    end
    local tCF = targetRoot.CFrame
    local look = tCF.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude < 0.001 then flatLook = Vector3.new(0, 0, -1) end
    flatLook = flatLook.Unit
    local right = flatLook:Cross(Vector3.new(0, 1, 0))
    local offsetWorld = right * offsetVec.X + Vector3.new(0, offsetVec.Y, 0) + flatLook * offsetVec.Z
    local dest = targetRoot.Position + offsetWorld
    return dest, CFrame.lookAt(dest, dest + flatLook)
end

-- ==================== 穿墙 ====================
local persistentNoclip = {}
local function trackPersistent(part)
    if persistentNoclip[part] then return end
    persistentNoclip[part] = {cc=part.CanCollide, ct=part.CanTouch}
    part.CanCollide = false
end
local function restorePersistent()
    local n = 0
    for part, data in pairs(persistentNoclip) do
        if part and part.Parent then
            pcall(function() part.CanCollide = data.cc; part.CanTouch = data.ct end)
            n = n + 1
        end
    end
    table.clear(persistentNoclip)
    return n
end
local function applyNoclipTransient()
    if St.noclip == "off" or St.noclip == "persistent" then return nil end
    local ch = LP.Character
    if not ch then return nil end
    local sv = {}
    local parts = {}
    if St.noclip == "basic" then
        local r = ch:FindFirstChild("HumanoidRootPart")
        if r then parts = {r} end
    else
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") then table.insert(parts, p) end
        end
    end
    for _, p in ipairs(parts) do
        sv[p] = {cc=p.CanCollide, ct=p.CanTouch}
        p.CanCollide = false
    end
    return sv
end
local function restoreNoclipTransient(sv)
    if not sv then return end
    for p, s in pairs(sv) do
        if p and p.Parent then
            pcall(function() p.CanCollide = s.cc; p.CanTouch = s.ct end)
        end
    end
end
local function applyNoclipPersistent()
    if St.noclip ~= "persistent" then return end
    local ch = LP.Character
    if not ch then return end
    for _, p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") then trackPersistent(p) end
    end
    local r = ch:FindFirstChild("HumanoidRootPart")
    if r then trackPersistent(r) end
end

local function forceNoclipAll()
    local ch = LP.Character
    if not ch then return {} end
    local saved = {}
    for _, p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            saved[p] = true
            p.CanCollide = false
        end
    end
    return saved
end
local function restoreForcedNoclip(saved)
    if not saved then return end
    for p, _ in pairs(saved) do
        if p and p.Parent then
            pcall(function() p.CanCollide = true end)
        end
    end
end

