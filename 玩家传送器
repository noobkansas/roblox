-- v15: 硬传送（无重力刷新延迟到调用方）
local function hardSet(r, S, dest, faceCF)
    if faceCF then r.CFrame = faceCF
    else
        local rp = r.CFrame - r.CFrame.Position
        r.CFrame = CFrame.new(dest) * rp
    end
    pcall(function()
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end)
    if S and S.hum and S.hum.Parent then S.hum:Move(Vector3.zero, false) end
end

local function stepWalk(S, tgt, dt)
    local r = S.r
    if not r or not r.Parent then return true end
    local hum = S.hum
    if not hum or not hum.Parent then return true end
    local pos = r.Position
    local diff = tgt - pos
    local horizDiff = Vector3.new(diff.X, 0, diff.Z)
    local horizDist = horizDiff.Magnitude
    local vertDist = diff.Y
    if not S.bv and math.abs(vertDist) > 8 then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(0, math.huge, 0); bv.P = 2000
        bv.Velocity = Vector3.new(0, math.sign(vertDist) * math.min(math.abs(vertDist) * 3, 300), 0)
        bv.Parent = r; S.bv = bv
    end
    if S.bv then
        if math.abs(vertDist) < 5 then S.bv:Destroy(); S.bv = nil
        else S.bv.Velocity = Vector3.new(0, math.sign(vertDist) * math.min(math.abs(vertDist) * 3, 300), 0) end
    end
    if horizDist > 3 then hum:Move(horizDiff.Unit, false) else hum:Move(Vector3.zero, false) end
    return (horizDist < 3 and math.abs(vertDist) < 5)
end

local function stepCFrame(S, tgt, dt, stealth, faceCF)
    local r = S.r
    if not r or not r.Parent then return true end
    local pos = r.Position
    local diff = tgt - pos
    local dist = diff.Magnitude
    local rp = r.CFrame - r.CFrame.Position
    local arriveEps = math.max(0.1, 1 / math.max(1, St.prec))
    if dist <= arriveEps then
        if faceCF then r.CFrame = faceCF
        else r.CFrame = CFrame.new(tgt) * rp end
        pcall(function()
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end)
        if S.hum and S.hum.Parent then S.hum:Move(Vector3.zero, false) end
        return true
    end
    local speedMul = 1
    if stealth then
        local elapsed = os.clock() - S.startTime
        local easeIn = 0.12
        if elapsed < easeIn then speedMul = elapsed / easeIn end
        local easeOutDist = 0.15 * St.speed
        if dist < easeOutDist then speedMul = math.min(speedMul, dist / easeOutDist) end
        if speedMul < 0.08 then speedMul = 0.08 end
        speedMul = speedMul * (1 + (math.random() - 0.5) * 0.1)
    end
    local maxMove = St.speed * dt * speedMul
    if maxMove > 100000 then maxMove = 100000 end
    local move = math.min(maxMove, dist)
    if move <= 0.0001 then
        pcall(function()
            r.AssemblyLinearVelocity = Vector3.new(0, r.AssemblyLinearVelocity.Y, 0)
            r.AssemblyAngularVelocity = Vector3.zero
        end)
        return false
    end
    local stepCount = 1
    if stealth then
        local prec = math.max(1, St.prec)
        stepCount = math.max(1, math.floor(move * prec))
        if stepCount > 240 then stepCount = 240 end
        local maxStep = St.stealthMaxStep or 18
        if move / stepCount > maxStep then
            stepCount = math.max(1, math.ceil(move / maxStep))
            if stepCount > 400 then stepCount = 400 end
        end
    end
    local stepMove = move / stepCount
    local curPos = pos
    for i = 1, stepCount do
        local d = tgt - curPos
        local remain = d.Magnitude
        if remain < 0.001 then break end
        local sd = math.min(stepMove, remain)
        local dir = d.Unit
        local offset = Vector3.zero
        if stealth then
            S.curvePhase = S.curvePhase + (dt / stepCount) * 1.8
            local perp = Vector3.new(-d.Z, 0, d.X)
            if perp.Magnitude > 0.01 then
                offset = perp.Unit * math.sin(S.curvePhase) * 1.5 * 0.01 * sd
            end
        end
        curPos = curPos + dir * sd + offset
    end
    local reached = (tgt - curPos).Magnitude <= arriveEps
    if stealth and S.ch then
        S.rayTimer = (S.rayTimer or 0) + dt
        if S.rayTimer >= 0.05 then
            S.rayTimer = 0
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = {S.ch}
            params.FilterType = Enum.RaycastFilterType.Exclude
            local res = workspace:Raycast(curPos + Vector3.new(0, 8, 0), Vector3.new(0, -160, 0), params)
            if res then
                local dY = curPos.Y - res.Position.Y
                if dY > -5 and dY < 10 then
                    curPos = Vector3.new(curPos.X, res.Position.Y + 3, curPos.Z)
                end
            end
        end
    end
    local finalCF
    if faceCF then
        finalCF = CFrame.lookAt(curPos, curPos + faceCF.LookVector)
    else
        local dispH = Vector3.new(curPos.X - pos.X, 0, curPos.Z - pos.Z)
        if dispH.Magnitude > 0.001 then
            if not S.lastDirH then
                S.lastDirH = dispH.Unit; S.faceBlend = 0
            else
                S.faceBlend = S.faceBlend + (1 - S.faceBlend) * math.min(dt * 12, 1)
                local blended = S.lastDirH:Lerp(dispH.Unit, S.faceBlend)
                if blended.Magnitude > 0.01 then S.lastDirH = blended.Unit else S.lastDirH = dispH.Unit end
            end
            finalCF = CFrame.lookAt(curPos, curPos + S.lastDirH)
        else
            finalCF = CFrame.new(curPos) * rp
        end
    end
    r.CFrame = finalCF
    if stealth then
        pcall(function()
            local actualDisp = curPos - pos
            r.AssemblyLinearVelocity = actualDisp / math.max(dt, 1/240)
            r.AssemblyAngularVelocity = Vector3.zero
        end)
    else
        pcall(function()
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    if S.hum and S.hum.Parent then S.hum:Move(Vector3.zero, false) end
    if stealth and S.ch then
        local hum = S.ch:FindFirstChildOfClass("Humanoid")
        if hum then
            local vel = r.AssemblyLinearVelocity
            local hs = math.sqrt(vel.X*vel.X + vel.Z*vel.Z)
            local cur = hum:GetState()
            if hs > 2 then
                if cur ~= Enum.HumanoidStateType.Running and cur ~= Enum.HumanoidStateType.Jumping and cur ~= Enum.HumanoidStateType.Freefall then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
            elseif hs < 0.5 then
                if cur == Enum.HumanoidStateType.Running then
                    hum:ChangeState(Enum.HumanoidStateType.Landed)
                end
            end
        end
    end
    return reached
end

local function stepInstant(S, tgt, faceCF)
    local r = S.r
    if not r or not r.Parent then return true end
    if faceCF then r.CFrame = faceCF
    else
        local rp = r.CFrame - r.CFrame.Position
        r.CFrame = CFrame.new(tgt) * rp
    end
    pcall(function()
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end)
    if S.hum and S.hum.Parent then S.hum:Move(Vector3.zero, false) end
    return true
end

local function engineStep(S, tgt, dt, faceCF)
    local byp = St.bypass
    if byp == "walk" then return stepWalk(S, tgt, dt)
    elseif byp == "hybrid" then return stepCFrame(S, tgt, dt, false, faceCF)
    elseif byp == "stealth" then return stepCFrame(S, tgt, dt, true, faceCF)
    else
        if St.mode == "teleport" then return stepInstant(S, tgt, faceCF)
        else return stepCFrame(S, tgt, dt, false, faceCF) end
    end
end

local function cleanupS(S)
    if not S then return end
    if S.bv then pcall(function() S.bv:Destroy() end); S.bv = nil end
    if S.noGrav then pcall(function() S.noGrav:Destroy() end); S.noGrav = nil end
    if S.r then removeNoGravity(S.r) end
    if S.hum and S.hum.Parent then
        pcall(function()
            S.hum.WalkSpeed = S.origWalkSpeed
            S.hum.JumpPower = S.origJumpPower
            if S.origAutoRotate ~= nil then S.hum.AutoRotate = S.origAutoRotate end
            if S.origAutoJump ~= nil then S.hum.AutoJumpEnabled = S.origAutoJump end
            S.hum:Move(Vector3.zero, false)
        end)
    end
end

local function doTpFixed(plr)
    local r = getMyRoot()
    if not r then return false end
    local tR = getPlayerRoot(plr)
    if not tR then return false end
    local savedCol = forceNoclipAll()
    local nocSv
    if St.noclip == "persistent" then applyNoclipPersistent()
    else nocSv = applyNoclipTransient() end
    local dest, faceCF = computeDestAndFace(tR)
    if St.mode == "teleport" and St.bypass == "off" then
        if faceCF then r.CFrame = faceCF
        else
            local rp = r.CFrame - r.CFrame.Position
            r.CFrame = CFrame.new(dest) * rp
        end
        pcall(function()
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end)
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:Move(Vector3.zero, false) end
        restoreNoclipTransient(nocSv)
        restoreForcedNoclip(savedCol)
        if St.noclip == "persistent" then applyNoclipPersistent() end
        return true
    end
    local S = buildS(r)
    if St.bypass == "walk" then
        if S.hum then S.hum.WalkSpeed = math.min(St.speed, 300) end
    end
    local done = false
    local conn
    conn = RS.Heartbeat:Connect(function(dt)
        if dead or done then return end
        if not r or not r.Parent then done = true; conn:Disconnect(); cleanupS(S); restoreForcedNoclip(savedCol); return end
        local newTR = getPlayerRoot(plr)
        if not newTR then done = true; conn:Disconnect(); cleanupS(S); restoreForcedNoclip(savedCol); return end
        local curDest, curFace = computeDestAndFace(newTR)
        if St.bypass == "walk" and S.hum and S.hum.Parent then
            local ws = math.min(St.speed, 300)
            if S.hum.WalkSpeed < ws then S.hum.WalkSpeed = ws end
        end
        if engineStep(S, curDest, dt, curFace) then
            done = true; conn:Disconnect(); cleanupS(S)
            restoreNoclipTransient(nocSv)
            restoreForcedNoclip(savedCol)
            if St.noclip == "persistent" then applyNoclipPersistent() end
        end
    end)
    return true
end

