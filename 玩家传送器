local function cl(v, lo, hi) if v < lo then return lo end if v > hi then return hi end return v end
local function clSpd(v) return cl(math.floor((toNumber(v) or 30)+0.5), 1, 200000) end
local function clPrec(v) return cl(math.floor((toNumber(v) or 10)+0.5), 1, 500) end
local function clStep(v) return cl(math.floor((toNumber(v) or 18)+0.5), 1, 500) end
local function clInterval(v) return cl(toNumber(v) or 1.5, 0.005, 60) end
local function clRate(v) return cl(math.floor((toNumber(v) or 60)+0.5), 1, 240) end
local function inRect(px, py, obj)
    local p, s = obj.AbsolutePosition, obj.AbsoluteSize
    if not p or not s then return false end
    return px >= p.X and px <= p.X + s.X and py >= p.Y and py <= p.Y + s.Y
end

local function parseOffset()
    local function parseAxis(str, def)
        str = tostring(str or ""):gsub("^%s+", ""):gsub("%s+$", "")
        local isLocal = false
        if str:sub(1,1) == "^" then
            isLocal = true
            str = str:sub(2):gsub("^%s+", "")
        end
        local n = toNumber(str)
        if not n then n = def end
        return n, isLocal
    end
    local ox, lx = parseAxis(St.offset.x, 0)
    local oy, ly = parseAxis(St.offset.y, 5)
    local oz, lz = parseAxis(St.offset.z, 0)
    return Vector3.new(ox, oy, oz), (lx or ly or lz)
end

