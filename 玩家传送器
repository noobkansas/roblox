        TextTransparency=1, LayoutOrder=1, Parent=card,
    })
    local ml = mk("TextLabel", {
        Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1,
        Font=Enum.Font.Gotham, TextSize=12, TextColor3=Th.Sub,
        TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, Text=msg or "",
        TextTransparency=1, LayoutOrder=2, Parent=card,
    })
    local fi = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    Tween:Create(card, fi, {BackgroundTransparency=0}):Play()
    Tween:Create(stroke, fi, {Transparency=0}):Play()
    Tween:Create(tl, fi, {TextTransparency=0}):Play()
    Tween:Create(ml, fi, {TextTransparency=0}):Play()
    task.delay(dur or 3, function()
        if dead or not card.Parent then return end
        local fo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        Tween:Create(card, fo, {BackgroundTransparency=1}):Play()
        Tween:Create(stroke, fo, {Transparency=1}):Play()
        Tween:Create(tl, fo, {TextTransparency=1}):Play()
        Tween:Create(ml, fo, {TextTransparency=1}):Play()
        task.delay(0.4, function() if not dead and card.Parent then card:Destroy() end end)
    end)
end

local dragState, resizeState = nil, nil
local function startDrag(frame, inputPos, onEnd)
    dragState = { frame=frame, startMouse=inputPos, startPos=frame.Position, onEnd=onEnd }
end
local function startResize(frame, inputPos, opts)
    opts = opts or {}
    resizeState = {
        frame=frame, startMouse=inputPos,
        startSize=Vector2.new(frame.AbsoluteSize.X, frame.AbsoluteSize.Y),
        minW=opts.minW or 200, minH=opts.minH or 60,
        maxW=opts.maxW or 1200, maxH=opts.maxH or 1600,
        onEnd=opts.onEnd,
    }
end

trk(UIS.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if dragState and dragState.frame.Parent then
        local d = input.Position - dragState.startMouse
        dragState.frame.Position = UDim2.new(
            dragState.startPos.X.Scale, dragState.startPos.X.Offset + d.X,
            dragState.startPos.Y.Scale, dragState.startPos.Y.Offset + d.Y
        )
    end
    if resizeState and resizeState.frame.Parent then
        local d = input.Position - resizeState.startMouse
        local w = cl(resizeState.startSize.X + d.X, resizeState.minW, resizeState.maxW)
        local h = cl(resizeState.startSize.Y + d.Y, resizeState.minH, resizeState.maxH)
        resizeState.frame.Size = UDim2.fromOffset(w, h)
    end
end))
trk(UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        if dragState then if dragState.onEnd then pcall(dragState.onEnd) end; dragState = nil end
        if resizeState then if resizeState.onEnd then pcall(resizeState.onEnd) end; resizeState = nil end
    end
end))

