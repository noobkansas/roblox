                r.frame.BackgroundColor3 = Th.AccD; r.frame.BackgroundTransparency = 0.05
            else
                r.frame.BackgroundColor3 = Th.Sur; r.frame.BackgroundTransparency = 0.5
            end
        end
        r._upd = upd; upd()
        trk(r.frame.MouseButton1Click:Connect(function() toggleSelIn(St.selAll, uid); refreshAllSel() end))
        trk(r.btnFollow.MouseButton1Click:Connect(function()
            if not isPlayerAlive(plr) then notify("跟随","目标无效",1.5,Th.Warn); return end
            local cam = workspace.CurrentCamera
            local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
            if cam and hum then
                cam.CameraSubject = hum
                St.camCurrent = nil; St.tempFollow = uid
                notify("跟随", "临时跟随 "..plr.Name.."（点画面取消）", 2, Th.Ok)
                for _, rr in pairs(allRows) do if rr._upd then rr._upd() end end
                for _, bl in pairs(allBlocks) do if bl._updCamStatus then pcall(bl._updCamStatus) end end
            end
        end))
        trk(r.btnTp.MouseButton1Click:Connect(function()
            if not isPlayerAlive(plr) then notify("传送","目标无效",1.5,Th.Warn); return end
            doTpFixed(plr); notify("传送", "→ "..plr.Name, 1.2, Th.Ok)
        end))
        trk(r.btnTpList.MouseButton1Click:Connect(function()
            pcall(function()
                if inList(St.tpTargets, uid) then
                    removeFromList(St.tpTargets, uid); St.selTp[uid] = nil
                else addToList(St.tpTargets, uid) end
                saveCfg()
                if renderTpListFn then renderTpListFn() end
                upd()
            end)
        end))
        trk(r.btnCamList.MouseButton1Click:Connect(function()
            pcall(function()
                if inList(St.camList, uid) then
                    removeFromList(St.camList, uid); St.selCam[uid] = nil
                    if St.camCurrent == uid then setCamTarget(nil) end
                else addToList(St.camList, uid) end
                saveCfg()
                if renderCamListFn then renderCamListFn() end
                upd()
            end)
        end))
        allRows[uid] = r
    end
    allEmpty.Visible = (n == 0)
    refreshAllSel()
end

renderTpListFn = function()
    if dead or not tpListInner then return end
    clearRows(tpListInner); tpRows = {}
    local arr = {}
    for _, uid in ipairs(St.tpTargets) do
        local plr = Players:GetPlayerByUserId(uid)
        if plr then table.insert(arr, plr) end
    end
    arr = sortPlayerArr(arr)
    local n = 0
    for _, plr in ipairs(arr) do
        n = n + 1
        local uid = plr.UserId
        local r = makeListRow(tpListInner, n, plr, "传")
        local function upd() r.dot.BackgroundColor3 = isPlayerAlive(plr) and Th.Ok or Th.Err end
        r._upd = upd; upd()
        trk(r.clickArea.MouseButton1Click:Connect(function() toggleSelIn(St.selTp, uid); refreshTpSel() end))
        trk(r.btnAct.MouseButton1Click:Connect(function()
            if not isPlayerAlive(plr) then notify("传送","目标无效",1.5,Th.Warn); return end
            doTpFixed(plr); notify("传送", "→ "..plr.Name, 1.2, Th.Ok)
        end))
        trk(r.btnRm.MouseButton1Click:Connect(function()
            pcall(function()
                removeFromList(St.tpTargets, uid); St.selTp[uid] = nil
                saveCfg()
                if renderTpListFn then renderTpListFn() end
                if allRows[uid] and allRows[uid]._upd then allRows[uid]._upd() end
            end)
        end))
        tpRows[uid] = r
    end
    tpEmpty.Visible = (n == 0)
    refreshTpSel()
end

renderCamListFn = function()
    if dead or not camListInner then return end
    clearRows(camListInner); camRows = {}
    local arr = {}
    for _, uid in ipairs(St.camList) do
        local plr = Players:GetPlayerByUserId(uid)
        if plr then table.insert(arr, plr) end
    end
    arr = sortPlayerArr(arr)
    local n = 0
    for _, plr in ipairs(arr) do
        n = n + 1
        local uid = plr.UserId
        local r = makeListRow(camListInner, n, plr, "锁")
        local function upd()
            r.dot.BackgroundColor3 = isPlayerAlive(plr) and Th.Ok or Th.Err
            if St.camCurrent == uid then r.btnAct.Text = "解"; r.btnAct.BackgroundColor3 = Th.Grn
            else r.btnAct.Text = "锁"; r.btnAct.BackgroundColor3 = Th.AccD end
        end
        r._upd = upd; upd()
        trk(r.clickArea.MouseButton1Click:Connect(function() toggleSelIn(St.selCam, uid); refreshCamSel() end))
        trk(r.btnAct.MouseButton1Click:Connect(function()
            if St.camCurrent == uid then setCamTarget(nil)
            else
                if not isPlayerAlive(plr) then notify("摄像机","目标无效",1.5,Th.Warn); return end
                setCamTarget(uid)
            end
            if renderCamListFn then renderCamListFn() end
            for _, rr in pairs(allRows) do if rr._upd then rr._upd() end end
        end))
        trk(r.btnRm.MouseButton1Click:Connect(function()
            pcall(function()
                removeFromList(St.camList, uid); St.selCam[uid] = nil
                if St.camCurrent == uid then setCamTarget(nil) end
                saveCfg()
                if renderCamListFn then renderCamListFn() end
                if allRows[uid] and allRows[uid]._upd then allRows[uid]._upd() end
            end)
        end))
        camRows[uid] = r
    end
    camEmpty.Visible = (n == 0)
    refreshCamSel()
end

renderAllList = renderAllListFn
renderTpList = renderTpListFn
renderCamList = renderCamListFn

