local function clearRows(container)
    for _, c in ipairs(container:GetChildren()) do
        if c:GetAttribute("isRow") then c:Destroy() end
    end
end

local function sortPlayerArr(arr)
    if St.sortBy == "name" then
        table.sort(arr, function(a, b)
            local an, bn = a.Name:lower(), b.Name:lower()
            if St.sortAsc then return an < bn else return an > bn end
        end)
    elseif St.sortBy == "distance" then
        local myRoot = getMyRoot()
        local myPos = myRoot and myRoot.Position
        if myPos then
            table.sort(arr, function(a, b)
                local aR = getPlayerRoot(a); local bR = getPlayerRoot(b)
                local aD = aR and (aR.Position - myPos).Magnitude or math.huge
                local bD = bR and (bR.Position - myPos).Magnitude or math.huge
                if St.sortAsc then return aD < bD else return aD > bD end
            end)
        end
    end
    return arr
end

local function collectSelUids(list, selTable)
    local arr = {}
    for _, uid in ipairs(list) do if selTable[uid] then table.insert(arr, uid) end end
    return arr
end
local function countAlive(list)
    local n = 0
    for _, uid in ipairs(list) do
        local plr = Players:GetPlayerByUserId(uid)
        if plr and isPlayerAlive(plr) then n = n + 1 end
    end
    return n
end
