local tpTask = nil
local realtimeLbl = nil

local function stopTpTask(silent)
    if tpTask then
        tpTask.running = false
        if tpTask.S then cleanupS(tpTask.S) end
        if tpTask.nocSv then restoreNoclipTransient(tpTask.nocSv) end
        if tpTask.savedCol then restoreForcedNoclip(tpTask.savedCol) end
        if tpTask.conn then pcall(function() tpTask.conn:Disconnect() end) end
        tpTask = nil
        if realtimeLbl then realtimeLbl.Text = "状态：空闲" end
        if not silent then notify("传送", "已停止", 1.5, Th.Sub) end
    end
end

-- v15: 瞬时切换到某目标（不做平滑，只硬 set）
local function instantSwitchTo(uid, r, S)
    local plr = Players:GetPlayerByUserId(uid)
    if not plr or not isPlayerAlive(plr) then return false end
    local tR = getPlayerRoot(plr)
    if not tR then return false end
    local dest, faceCF = computeDestAndFace(tR)
    hardSet(r, S, dest, faceCF)
    return true
end

local function startTpTask(uids)
    if tpTask and tpTask.running then
        notify("传送", "已有传送任务运行中", 2, Th.Warn); return
    end
    if not uids or #uids == 0 then
        notify("传送", "传送列表选中为空", 2, Th.Warn); return
    end
    local savedCol = forceNoclipAll()
    local nocSv
    if St.noclip == "persistent" then applyNoclipPersistent()
    else nocSv = applyNoclipTransient() end
    tpTask = {
        running=true, mode=St.tpMode, uids=uids,
        idx=1, phase="moving", elapsed=0, stickyAcc=0,
        switchCount=0, runTime=0, lastRateShow=0, lastSwitchCount=0,
        S=nil, nocSv=nocSv, savedCol=savedCol, conn=nil,
    }
    local modeLabel = ({single="单次", sticky="粘滞", loop="循环"})[St.tpMode] or St.tpMode
    notify("传送", string.format("[%s] 开始 · %d 目标 · 间隔%.3fs", modeLabel, #uids, St.interval), 2, Th.Ok)

    -- v15: 高频模式阈值 0.05 秒
    local highFreq = St.interval < 0.05

    tpTask.conn = RS.Heartbeat:Connect(function(dt)
        if dead or not tpTask or not tpTask.running then return end
        if #tpTask.uids == 0 then stopTpTask(true); notify("传送", "任务列表为空", 2, Th.Warn); return end

        local r = getMyRoot()
        if not r then return end

        -- 初始化 S
        if not tpTask.S or tpTask.S.r ~= r then
            if tpTask.S then cleanupS(tpTask.S) end
            tpTask.S = buildS(r)
            if tpTask.S.hum and tpTask.S.hum.Parent then
                pcall(function()
                    tpTask.S.hum.AutoRotate = false
                    tpTask.S.hum.AutoJumpEnabled = false
                end)
            end
        end
        local S = tpTask.S

        -- 时间累计
        tpTask.elapsed = tpTask.elapsed + dt
        tpTask.runTime = tpTask.runTime + dt

        -- 检查是否要切换目标（可能一帧切多个）
        -- 但每切一个都要瞬移到新目标
        local maxIter = 240
        while tpTask.elapsed >= St.interval and maxIter > 0 do
            maxIter = maxIter - 1
            tpTask.elapsed = tpTask.elapsed - St.interval
            tpTask.idx = tpTask.idx + 1
            tpTask.switchCount = tpTask.switchCount + 1

            -- 边界检查 + 目标有效性检查
            local guard = 0
            local ok = true
            while guard < #tpTask.uids + 1 do
                guard = guard + 1
                if tpTask.idx > #tpTask.uids then
                    if tpTask.mode == "loop" then
                        tpTask.idx = 1
                    else
                        stopTpTask(true); notify("传送", "已完成", 2, Th.Ok)
                        ok = false
                        break
                    end
                end
                local uid = tpTask.uids[tpTask.idx]
                local plr = Players:GetPlayerByUserId(uid)
                if plr and isPlayerAlive(plr) then
                    -- 有效目标，瞬移过去
                    instantSwitchTo(uid, r, S)
                    break
                else
                    -- 无效目标，继续下一个
                    tpTask.idx = tpTask.idx + 1
                end
            end
            if not ok then return end
        end

        if not tpTask or not tpTask.running then return end

        -- 当前目标（如果没切换，则继续追当前目标）
        if tpTask.idx > #tpTask.uids then
            if tpTask.mode == "loop" then tpTask.idx = 1
            else stopTpTask(true); notify("传送", "已完成", 2, Th.Ok); return end
        end
        local uid = tpTask.uids[tpTask.idx]
        local plr = Players:GetPlayerByUserId(uid)
        if not plr or not isPlayerAlive(plr) then
            tpTask.idx = tpTask.idx + 1
            tpTask.phase = "moving"
            return
        end

        local tR = getPlayerRoot(plr)
        if not tR then
            tpTask.idx = tpTask.idx + 1
            tpTask.phase = "moving"
            return
        end
        local dest, faceCF = computeDestAndFace(tR)

        -- 高频模式：不做平滑，只每帧钉住
        if highFreq then
            if St.lockPos then
                tpTask.stickyAcc = tpTask.stickyAcc + dt
                local period = 1 / math.max(1, St.stickyRate)
                while tpTask.stickyAcc >= period do
                    tpTask.stickyAcc = tpTask.stickyAcc - period
                    hardSet(r, S, dest, faceCF)
                end
            else
                -- 至少每帧调一次
                if not tpTask.phase or tpTask.phase == "moving" then
                    hardSet(r, S, dest, faceCF)
                end
            end
        else
            -- 低频模式：走平滑引擎 + 钉住
            if tpTask.phase == "moving" then
                if St.bypass == "walk" and S.hum and S.hum.Parent then
                    local ws = math.min(St.speed, 300)
                    if S.hum.WalkSpeed < ws then S.hum.WalkSpeed = ws end
                end
                if engineStep(S, dest, dt, faceCF) then
                    tpTask.phase = "waiting"
                end
            else
                if St.lockPos then
                    tpTask.stickyAcc = tpTask.stickyAcc + dt
                    local period = 1 / math.max(1, St.stickyRate)
                    while tpTask.stickyAcc >= period do
                        tpTask.stickyAcc = tpTask.stickyAcc - period
                        hardSet(r, S, dest, faceCF)
                    end
                end
            end
        end

        -- 每帧刷新无重力（省性能：只在有 S.noGrav 时刷新）
        if S.noGrav and S.noGrav.Parent then
            refreshNoGravity(r, S.noGrav)
        end

        -- UI 实时显示（每 0.5 秒更新一次）
        if realtimeLbl and (tpTask.runTime - tpTask.lastRateShow) >= 0.5 then
            tpTask.lastRateShow = tpTask.runTime
            local dCount = tpTask.switchCount - tpTask.lastSwitchCount
            tpTask.lastSwitchCount = tpTask.switchCount
            local rate = dCount * 2  -- 0.5 秒 × 2 = 每秒
            realtimeLbl.Text = string.format("运行 %.1fs · 目标 #%d/%d · 切换 %d 次 · %.0f 次/s",
                tpTask.runTime, tpTask.idx, #tpTask.uids, tpTask.switchCount, rate)
        end
    end)
end

