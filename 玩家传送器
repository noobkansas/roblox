-- ==================== 事件 ====================
trk(Players.PlayerAdded:Connect(function()
    task.defer(function() if not dead then renderAllList() end end)
end))
trk(Players.PlayerRemoving:Connect(function(plr)
    removeFromList(St.tpTargets, plr.UserId)
    removeFromList(St.camList, plr.UserId)
    St.selAll[plr.UserId] = nil
    St.selTp[plr.UserId] = nil
    St.selCam[plr.UserId] = nil
    if St.camCurrent == plr.UserId then setCamTarget(nil) end
    if St.tempFollow == plr.UserId then St.tempFollow = nil; setCamTarget(nil) end
    saveCfg()
    task.defer(function()
        if dead then return end
        renderAllList(); renderTpList(); renderCamList()
    end)
end))

trk(LP.CharacterAdded:Connect(function()
    if St.camCurrent then
        local uid = St.camCurrent
        task.delay(0.6, function()
            if dead then return end
            local plr = Players:GetPlayerByUserId(uid)
            if plr then
                local cam = workspace.CurrentCamera
                local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
                if cam and hum then cam.CameraSubject = hum end
            end
        end)
    elseif St.tempFollow then St.tempFollow = nil end
end))

trk(UIS.InputBegan:Connect(function(input, gpe)
    if dead or gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        if St.tempFollow then
            St.tempFollow = nil
            setCamTarget(nil); renderCamList()
            for _, r in pairs(allRows) do if r._upd then r._upd() end end
            notify("跟随", "已取消临时跟随", 1.2, Th.Sub)
        end
    end
end))

local distTimer = 0
trk(RS.Heartbeat:Connect(function(dt)
    if dead then return end
    distTimer = distTimer + dt
    if distTimer < 0.3 then return end
    distTimer = 0
    local myRoot = getMyRoot()
    local myPos = myRoot and myRoot.Position
    local function updRows(rows)
        for uid, r in pairs(rows) do
            local plr = Players:GetPlayerByUserId(uid)
            if not plr then r.distLbl.Text = "--"
            else
                if myPos then
                    local tR = getPlayerRoot(plr)
                    r.distLbl.Text = tR and string.format("%.0f", (tR.Position - myPos).Magnitude) or "--"
                end
                if r.dot then r.dot.BackgroundColor3 = isPlayerAlive(plr) and Th.Ok or Th.Err end
            end
        end
    end
    updRows(allRows); updRows(tpRows); updRows(camRows)
    if infoAllLbl then refreshAllSel() end
    if infoTpLbl then refreshTpSel() end
    if infoCamLbl then refreshCamSel() end
    if St.camCurrent then
        local plr = Players:GetPlayerByUserId(St.camCurrent)
        if not plr then setCamTarget(nil)
        else
            local cam = workspace.CurrentCamera
            local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
            if cam and hum and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
        end
    end
end))

trk(UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightAlt then
        St.hidden = not St.hidden
        applyGlobalVisibility()
        notify("面板", St.hidden and "已隐藏 (RightAlt 恢复)" or "已显示", 2,
               St.hidden and Th.Warn or Th.Ok)
    end
end))

local saveTimer = 0
trk(RS.Heartbeat:Connect(function(dt)
    if dead then return end
    saveTimer = saveTimer + dt
    if saveTimer >= SAVE_INT then saveTimer = 0; saveCfg() end
end))

applyMainMin()
applyGlobalVisibility()
renderAllList()
renderTpList()
renderCamList()

local Api
local function destroy()
    if dead then return end
    dead = true
    stopTpTask(true)
    restorePersistent()
    local cam = workspace.CurrentCamera
    if cam then
        local myHum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        pcall(function() cam.CameraSubject = myHum end)
    end
    saveCfg()
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    table.clear(Conns)
    pcall(function() sg:Destroy() end)
    pcall(function() notifGui:Destroy() end)
    if gE[SCRIPT_ID] == Api then gE[SCRIPT_ID] = nil end
end
trk(mCls.MouseButton1Click:Connect(destroy))

Api = { version = VERSION, state = St, destroy = destroy, gui = sg }
gE[SCRIPT_ID] = Api

notify("玩家传送管理器", "v"..VERSION.." 已加载 · RightAlt 隐藏", 3, Th.Ok)
if not hasFile then
    task.delay(3.6, function() notify("提示", "文件存档不可用", 3, Th.Warn) end)
end
